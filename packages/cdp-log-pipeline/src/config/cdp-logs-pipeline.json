  {
    "obfuscate": {
      "source": "/labels/MessageBody",
      "target": "/labels/MessageBody",
      "patterns": [
        "(?:^|\\s)[A-Za-z0-9+_.-]+@(?:[A-Za-z0-9-]+\\.){1,20}[A-Za-z]{2,24}(?=$|\\s)",
        "(password|Password|pass|PASSWORD)[=: ]*[a-zA-Z0-9\\*\\.!@#$%\\^&()\"\\'\\{\\}\\[\\]\\:;<>,\\?\\/\\~_\\+-=\\|\\-]{4,32}",
        "(username|user|USER|USERNAME).{0,10}[A-Za-z0-9_.-]{2,24}",
        "(?i)\\b(?:[A-Za-z0-9][A-Za-z0-9.'\\- ]{1,80},\\s*){1,20}[A-Z]{1,2}\\d[A-Z\\d]?\\s?\\d[A-Z]{2}\\b",
        "(card|credit_card|credit-card|card_number|visa|mastercard|CARD|CREDIT_CARD|VISA|MASTERCARD|Card|CardNumber).{0,5}(\\d{4}[\\s\\-\\.]?){3}\\d{4}",
        "(registration_number|registration-number|REGISTRATION_NUMBER|REGISTRATION-NUMBER|vehicle_registration|vehicle-registration|VEHICLE_REGISTRATION|VEHICLE-REGISTRATION|car_registration|car-registration|CAR_REGISTRATION|CAR-REGISTRATION|number_plate|NumberPlate|NUMBER_PLATE|NUMBER-PLATE).{0,5}([A-Z]{2}[0-9]{2}[A-Z]{3}|[a-z]{2}[0-9]{2}[a-z]{3})",
        "\\b0[1-9][0-9]{9,10}\\b",
        "\\+44\\s?7\\d{3}\\s?\\d{6}\\b",
        "(drivinglicense|driving_license|driving|DRIVING_LICENSE|DrivingLicense).{0,10}[\\w9]{5}\\d{6}[\\w]{2}\\d{1}[\\w]{2}",
        "(passport|Passport|PASSPORT|passport_number|PASSPORT_NUMBER).{0,10}\\d{9}",
        "(surname|lastname|firstname|name|Surname|Lastname|Firstname|Name|FirstName|LastName|SURNAME|LASTNAME|FIRSTNAME|NAME).{0,10}[A-Za-z]{2,24}",
        "(street|Street|STREET).{0,10}?[A-Za-z0-9\\s,.-]{3,50}",
        "(address|Address|ADDRESS).{0,10}?[A-Za-z0-9\\s,.-]{5,100}",
        "(postalcode|PostalCode|Postcode|PostCode|postal_code|POSTAL_CODE|POSTALCODE|postcode|POSTCODE).{0,10}[A-Z0-9\\s]{3,10}",
        "(birth|birthdate|birthday|dob|born|Born|DOB|Dob|DoB)\\W+(?:\\w+\\W+){0,5}?(?<REDACT>(\\d{4}|\\d{1,2})[\\/\\-]\\d{1,2}[\\/\\-](\\d{4}|\\d{1,2}))",
        "<[^>]*:?(FirstName|LastName|Name|Phone|Street|Address|PostalCode|eMail|firstname|lastname|name|phone|street|address|postalcode|email)[^>]*>([^<]+)</[^>]*>"
      ],
      "action": {
        "mask": {
          "mask_character": "*",
          "mask_character_length": 6
        }
      }
    }
  },
