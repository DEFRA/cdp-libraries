[
  {
    "rename_keys": {
      "entries": [
        {
          "from_key": "log",
          "to_key": "temp_log",
          "overwrite_if_to_key_exists": true
        }
      ]
    }
  },
  {
    "add_entries": {
      "entries": [
        {
          "key": "message",
          "format": "${temp_log}",
          "add_when": "/temp_log typeof string"
        },
        {
          "key": "log.level",
          "value": "error",
          "add_when": "/temp_log typeof string",
          "overwrite_if_key_exists": true
        },
        {
          "key": "console.log",
          "value": true,
          "add_when": "/temp_log typeof string",
          "overwrite_if_key_exists": true
        },
        {
          "key": "log/logger",
          "value_expression": "/temp_log/logger",
          "add_when": "/temp_log typeof map and /temp_log/logger != null"
        },
        {
          "key": "log/file/path",
          "value_expression": "/temp_log/file/path",
          "add_when": "/temp_log typeof map and /temp_log/file/path != null"
        }
      ]
    }
  },
