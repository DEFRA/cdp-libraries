{
  "name": "@defra/cdp-log-pipeline",
  "version": "0.1.0",
  "description": "Run your service's logs through a local copy of the CDP log pipeline to see what ends up in OpenSearch",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "homepage": "https://github.com/DEFRA/cdp-libraries/tree/main/packages/cdp-log-pipeline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/cdp-libraries.git"
  },
  "bugs": {
    "url": "https://github.com/DEFRA/cdp-libraries/issues"
  },
  "keywords": [
    "cdp",
    "defra",
    "logging",
    "opensearch"
  ],
  "main": "src/log-pipeline.js",
  "exports": {
    ".": "./src/log-pipeline.js"
  },
  "bin": {
    "cdp-log-pipeline": "bin/cdp-log-pipeline.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.js",
    "!src/config/*.sha256"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "github:release": "npx cdp-github-release cdp-log-pipeline",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "test": "vitest run --coverage"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "releaseName": "Release cdp-log-pipeline ${version}",
      "releaseNotes": "echo ''"
    },
    "git": {
      "commitMessage": "Tagged cdp-log-pipeline ${version}",
      "tagName": "cdp-log-pipeline-${version}",
      "requireCleanWorkingDir": false,
      "commitArgs": [
        "--no-verify"
      ]
    }
  }
}
